{
  "name": "@pithecene/quarry-sdk",
  "version": "0.14.1",
  "license": "Apache-2.0",
  "author": "Pithecene <contact@pithecene.sh>",
  "homepage": "https://github.com/pithecene/quarry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithecene/quarry.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/pithecene/quarry/issues"
  },
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only"
  },
  "peerDependencies": {
    "puppeteer": "^24 || ^25",
    "puppeteer-extra": "^3"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "puppeteer": "^25.14.0",
    "puppeteer-extra": "^3.3.6",
    "tsdown": "^0.20.3"
  }
}
